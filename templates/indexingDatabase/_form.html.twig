{#
IndexingDatabase Form Component (for create, edit, and propose)
Parameters:
- indexingDatabase: (optional) IndexingDatabase entity for edit mode
- formAction: URL for form submission
- csrfTokenId: CSRF token identifier
- cancelUrl: URL for cancel button
- submitLabel: (optional) Label for submit button (default: 'indexingDatabase.form.save')
- submitIcon: (optional) Icon for submit button (default: 'fa-save')
#}

{% set isEdit = indexingDatabase is defined and indexingDatabase is not null %}

<form method="post" action="{{ formAction }}" enctype="multipart/form-data">
    <input type="hidden" name="_token" value="{{ csrf_token(csrfTokenId) }}">

    <p class="text-muted mb-3">
        <span class="text-danger">*</span> {{ 'indexingDatabase.form.requiredFields'|trans }}
    </p>

    <!-- Name -->
    <div class="mb-3">
        <label for="name" class="form-label">
            {{ 'indexingDatabase.form.name'|trans }} <span class="text-danger" aria-hidden="true">*</span>
        </label>
        <input type="text"
               class="form-control"
               id="name"
               name="name"
               value="{{ isEdit ? indexingDatabase.name|default('')|e('html_attr') : '' }}"
               required>
    </div>

    <!-- URL -->
    <div class="mb-3"
         data-controller="indexing-database-url"
         data-indexing-database-url-check-url-path-value="{{path('app_admin_indexing_database_check_url') }}">
        <label for="url" class="form-label">
            {{ 'indexingDatabase.form.url'|trans }}
        </label>
        <input type="url"
               class="form-control"
               id="url"
               name="url"
               placeholder="https://"
               value="{{ isEdit ? indexingDatabase.url|default('')|e('html_attr') : '' }}"
               data-action="blur->indexing-database-url#validateUrl"
               data-error-message="{{'indexingDatabase.error.duplicate_url'|trans }}">
        <div class="alert alert-danger d-none mt-2" data-indexing-database-url-target="error"></div>
    </div>

    <!-- Logo -->
    <div class="mb-3">
        <label for="logo" class="form-label">
            {{ 'indexingDatabase.form.logo'|trans }}
        </label>
        {% if isEdit and indexingDatabase.logo %}
            <div class="mb-2">
                <img src="{{ path('app_indexing_database_logo', {filename: indexingDatabase.logo}) }}"
                     alt="{{ indexingDatabase.name }}"
                     style="max-height: 50px;"
                     class="border rounded p-1">
                <div class="form-check mt-1">
                    <input class="form-check-input" type="checkbox" id="remove_logo" name="remove_logo" value="1">
                    <label class="form-check-label text-danger" for="remove_logo">
                        {{ 'indexingDatabase.form.removeLogo'|trans }}
                    </label>
                </div>
            </div>
        {% endif %}
        <div class="d-flex align-items-center gap-2"
             data-controller="indexing-database-file-input"
             data-indexing-database-file-input-placeholder-value="{{ 'indexingDatabase.form.noFileSelected'|trans }}">
            <label for="logo" class="btn btn-outline-secondary mb-0">
                <i class="fas fa-upload me-1"></i>{{ 'indexingDatabase.form.browse'|trans }}
            </label>
            <span data-indexing-database-file-input-target="filename" class="text-muted">
                {{ 'indexingDatabase.form.noFileSelected'|trans }}
            </span>
            <input type="file"
                   class="d-none"
                   id="logo"
                   name="logo"
                   accept=".png,.jpg,.jpeg,.gif,.svg,.webp"
                   data-indexing-database-file-input-target="input"
                   data-action="change->indexing-database-file-input#updateFilename">
        </div>
        <div class="form-text text-muted">{{ 'indexingDatabase.form.logoHelp'|trans }}</div>
    </div>

    <!-- Buttons -->
    <div class="d-flex justify-content-center gap-2 mt-4">
        <a href="{{ cancelUrl }}" class="btn btn-outline-secondary">
            {{ 'indexingDatabase.form.cancel'|trans }}
        </a>
        <button type="submit" class="btn btn-primary">
            <i class="fas {{ submitIcon|default('fa-save') }} me-1"></i>
            {{ (submitLabel|default('indexingDatabase.form.save'))|trans }}
        </button>
    </div>
</form>
