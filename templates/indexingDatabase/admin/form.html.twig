{% extends 'base.html.twig' %}

{% set isEdit = indexingDatabase is defined and indexingDatabase is not null %}

{% block body %}
    <div class="container">
        {% if app.user and app.user.userIdentifier != '__NO_USER__' %}
            {% include 'partials/navbar.html.twig' %}
        {% endif %}

        <div class="text-center my-4">
            {% if isEdit %}
                <h1><i class="fas fa-edit me-2"></i>{{ 'indexingDatabase.admin.editTitle'|trans }}</h1>
            {% else %}
                <h1><i class="fas fa-plus me-2"></i>{{ 'indexingDatabase.admin.createTitle'|trans }}</h1>
            {% endif %}
        </div>

        {% include 'components/flash_messages.html.twig' %}
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="card">
                    <div class="card-body">
                        {% include 'indexingDatabase/_form.html.twig' with {
                            indexingDatabase: isEdit ? indexingDatabase : null,
                            formAction: isEdit
                            ? path('app_admin_indexing_database_edit', {id: indexingDatabase.id})
                            : path('app_admin_indexing_database_create'),
                            csrfTokenId: isEdit
                            ? 'indexing-database-edit-' ~ indexingDatabase.id
                            : 'indexing-database-create',
                            cancelUrl: path('app_admin_indexing_database_index')
                        } %}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
