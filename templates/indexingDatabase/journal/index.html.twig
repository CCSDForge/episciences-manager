{% extends 'base.html.twig' %}

{% block body %}
    <div class="container"
         data-controller="journal-indexing"
         data-journal-indexing-associated-message-value="{{ 'indexingDatabase.flash.associated'|trans }}"
         data-journal-indexing-dissociated-message-value="{{ 'indexingDatabase.flash.dissociated'|trans }}">


        <div class="row">
            <div class="col-6 pt-4">
                <a href="{{ path('app_journal_dashboard', {'code': code}) }}" class="btn btn-outline-secondary btn-sm">
                    <i class="fas fa-arrow-left me-2"></i>{{ 'journalDashboard.backToJournalList'|trans }}
                </a>
            </div>
                {% if is_granted('INDEXING_DATABASE_ADMIN_LIST') %}
                <a href="{{ path('app_admin_indexing_database_index') }}" ...>
                    {% endif %}
                </a>
        </div>

        <div class="d-flex justify-content-between align-items-center pt-4 mb-4">
            <h1 class="my-0">{{ 'indexingDatabase.journal.title'|trans }}</h1>
            {% if canPropose %}
                <button type="button" class="btn btn-primary"
                        data-bs-toggle="modal" data-bs-target="#proposeModal">
                    <i class="fas fa-plus me-2"></i>{{ 'indexingDatabase.journal.propose'|trans }}
                </button>
            {% endif %}
        </div>
        {% include 'components/flash_messages.html.twig' %}

        {# Alert container for AJAX messages (Stimulus target) #}
        <div data-journal-indexing-target="alert"></div>

        {# Section: Available indexing databases #}
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">{{ 'indexingDatabase.journal.availableDatabases'|trans }}</h5>
            </div>
            <div class="card-body">
                {% if indexingDatabases|length > 0 %}
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                            <tr>
                                <th style="width: 25%">{{ 'indexingDatabase.admin.tableName'|trans }}</th>
                                <th style="width: 15%">{{ 'indexingDatabase.admin.tableLogo'|trans }}</th>
                                <th style="width: 45%">{{ 'indexingDatabase.admin.tableUrl'|trans }}</th>
                                <th style="width: 15%" class="text-center">{{ 'indexingDatabase.journal.indexed'|trans }}</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for db in indexingDatabases %}
                                <tr>
                                    <td>
                                        {{ db.name }}
                                    </td>
                                    <td>
                                        {% if db.logo %}
                                            <img src="{{ path('app_indexing_database_logo', {filename: db.logo}) }}"
                                                 alt="{{ db.name }}" style="height: 24px; margin-right: 8px;">
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if db.url %}
                                            <a href="{{ db.url }}" target="_blank" rel="noopener">{{ db.url }}</a>
                                        {% else %}
                                            <span class="text-muted">-</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-center">
                                        <div class="form-check form-switch d-flex justify-content-center">
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   role="switch"
                                                   data-journal-indexing-target="toggle"
                                                   data-action="change->journal-indexing#toggle"
                                                   data-id="{{ db.id }}"
                                                   data-name="{{ db.name }}"
                                                   data-url="{{ path('app_journal_indexing_toggle', {'code': code, 'id': db.id}) }}"
                                                   data-token="{{ csrf_token('indexing-toggle-' ~ db.id) }}"
                                                    {{ db.id in associatedIds ? 'checked' : '' }}>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <p class="text-muted mb-0">{{ 'indexingDatabase.admin.noDatabase'|trans }}</p>
                {% endif %}
            </div>
        </div>

        {# Section: Propose a new database (if allowed) #}


        {# Section: Pending proposals #}
        {% if pendingProposals|length > 0 %}
            <div class="card mb-4">
                <div class="card-header bg-warning-subtle">
                    <h5 class="mb-0">{{ 'indexingDatabase.journal.pendingProposals'|trans }}</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                            <tr>
                                <th style="width: 25%">{{ 'indexingDatabase.admin.tableName'|trans }}</th>
                                <th style="width: 15%">{{ 'indexingDatabase.admin.tableLogo'|trans }}</th>
                                <th style="width: 45%">{{ 'indexingDatabase.admin.tableUrl'|trans }}</th>
                                <th style="width: 15%" class="text-center">{{ 'indexingDatabase.admin.tableStatus'|trans }}</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for proposal in pendingProposals %}
                                <tr>
                                    <td>{{ proposal.name }}</td>
                                    <td>
                                        {% if proposal.logo %}
                                            <img src="{{ path('app_indexing_database_logo', {filename: proposal.logo}) }}"
                                                 alt="{{ proposal.name }}"
                                                 style="height: 24px;">
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if proposal.url %}
                                            <a href="{{ proposal.url }}" target="_blank" rel="noopener">{{ proposal.url }}</a>
                                        {% else %}
                                            <span class="text-muted">-</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-warning">{{ 'indexingDatabase.status.pending'|trans }}</span>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        {% endif %}

        {# Section: Rejected proposals #}
        {% if rejectedProposals|length > 0 %}
            <div class="card mb-4">
                <div class="card-header bg-danger-subtle">
                    <h5 class="mb-0">{{ 'indexingDatabase.journal.rejectedProposals'|trans }}</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                            <tr>
                                <th style="width: 25%">{{ 'indexingDatabase.admin.tableName'|trans }}</th>
                                <th style="width: 15%">{{ 'indexingDatabase.admin.tableLogo'|trans }}</th>
                                <th style="width: 45%">{{ 'indexingDatabase.admin.tableUrl'|trans }}</th>
                                <th style="width: 15%" class="text-center">{{ 'indexingDatabase.admin.tableStatus'|trans }}</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for proposal in rejectedProposals %}
                                <tr>
                                    <td>{{ proposal.name }}</td>
                                    <td>
                                        {% if proposal.logo %}
                                            <img src="{{ path('app_indexing_database_logo', {filename: proposal.logo}) }}"
                                                 alt="{{ proposal.name }}"
                                                 style="height: 24px;">
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if proposal.url %}
                                            <a href="{{ proposal.url }}" target="_blank" rel="noopener">{{ proposal.url }}</a>
                                        {% else %}
                                            <span class="text-muted">-</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-danger">{{ 'indexingDatabase.status.rejected'|trans }}</span>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        {% endif %}

    </div>
    {# Modal for proposing a new indexing database #}
    {% if canPropose %}
        <div class="modal fade" id="proposeModal" tabindex="-1"
             aria-labelledby="proposeModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="proposeModalLabel">
                            {{ 'indexingDatabase.journal.proposeTitle'|trans
                            }}
                        </h5>
                        <button type="button" class="btn-close"
                                data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-muted">{{
                            'indexingDatabase.journal.proposeInfo'|trans }}</p>
                        {% include 'indexingDatabase/_form.html.twig' with {
                            formAction: path('app_journal_indexing_propose',
                                {'code': code}),
                            csrfTokenId: 'indexing-propose',
                            cancelUrl: null,
                            submitLabel: 'indexingDatabase.journal.propose',
                            submitIcon: 'fa-paper-plane'
                        } %}
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}
