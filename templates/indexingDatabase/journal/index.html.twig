{% extends 'base.html.twig' %}

{% block body %}
    <div class="container"
         data-controller="indexing-database-toggle"
         data-indexing-database-toggle-associated-message-value="{{ 'indexingDatabase.flash.associated'|trans }}"
         data-indexing-database-toggle-dissociated-message-value="{{ 'indexingDatabase.flash.dissociated'|trans }}">


        <div class="row">
            <div class="col-6 pt-4">
                <a href="{{ path('app_journal_dashboard', {'code': code}) }}" class="btn btn-outline-secondary btn-sm">
                    <i class="fas fa-arrow-left me-2"></i>{{ 'journalPages.back'|trans }}
                </a>
            </div>
            <div class="col-6 pt-4 text-end">
                {% if is_granted('INDEXING_DATABASE_ADMIN_LIST') %}
                    <a href="{{ path('app_admin_indexing_database_index') }}" class="btn btn-outline-secondary btn-sm">
                        <i class="fas fa-cog me-2"></i>{{ 'indexingDatabase.admin.title'|trans }}
                    </a>
                {% endif %}
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center pt-4 mb-4">
            <h1 class="my-0">{{ 'indexingDatabase.journal.title'|trans }}</h1>
            {% if canPropose %}
                <button type="button" class="btn btn-primary"
                        data-bs-toggle="modal" data-bs-target="#proposeModal">
                    <i class="fas fa-plus me-2"></i>{{ 'indexingDatabase.journal.propose'|trans }}
                </button>
            {% endif %}
        </div>
        {% include 'components/flash_messages.html.twig' %}

        {# Section: Available indexing databases #}
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">{{ 'indexingDatabase.journal.availableDatabases'|trans }}</h5>
            </div>
            <div class="card-body">
                {% if pagination.totalItemCount > 0 %}
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                            <tr>
                                <th style="width: 25%">{{ 'indexingDatabase.admin.tableName'|trans }}</th>
                                <th style="width: 15%">{{ 'indexingDatabase.admin.tableLogo'|trans }}</th>
                                <th style="width: 45%">{{ 'indexingDatabase.admin.tableUrl'|trans }}</th>
                                <th style="width: 15%" class="text-center">{{ 'indexingDatabase.journal.indexed'|trans }}</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for db in pagination %}
                                {% include 'indexingDatabase/journal/_database_row.html.twig' with {
                                    database: db,
                                    lastColumn: 'toggle',
                                    code: code,
                                    associatedIds: associatedIds
                                } %}
                            {% endfor %}
                            </tbody>
                        </table>
                        <div class="d-flex justify-content-center mt-3">
                            {{ knp_pagination_render(pagination) }}
                        </div>
                    </div>
                {% else %}
                    <p class="text-muted mb-0">{{ 'indexingDatabase.admin.noDatabase'|trans }}</p>
                {% endif %}
            </div>
        </div>

        {# Section: Propose a new database (if allowed) #}


        {# Section: Pending proposals #}
        {% if pendingProposals|length > 0 %}
            <div class="card mb-4">
                <div class="card-header bg-warning-subtle">
                    <h5 class="mb-0">{{ 'indexingDatabase.journal.pendingProposals'|trans }}</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                            <tr>
                                <th style="width: 25%">{{ 'indexingDatabase.admin.tableName'|trans }}</th>
                                <th style="width: 15%">{{ 'indexingDatabase.admin.tableLogo'|trans }}</th>
                                <th style="width: 45%">{{ 'indexingDatabase.admin.tableUrl'|trans }}</th>
                                <th style="width: 15%" class="text-center">{{ 'indexingDatabase.admin.tableStatus'|trans }}</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for proposal in pendingProposals %}
                                {% include 'indexingDatabase/journal/_database_row.html.twig' with {
                                    database: proposal,
                                    lastColumn: 'status'
                                } %}
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        {% endif %}

        {# Section: Rejected proposals #}
        {% if rejectedProposals|length > 0 %}
            <div class="card mb-4">
                <div class="card-header bg-danger-subtle">
                    <h5 class="mb-0">{{ 'indexingDatabase.journal.rejectedProposals'|trans }}</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                            <tr>
                                <th style="width: 25%">{{ 'indexingDatabase.admin.tableName'|trans }}</th>
                                <th style="width: 15%">{{ 'indexingDatabase.admin.tableLogo'|trans }}</th>
                                <th style="width: 45%">{{ 'indexingDatabase.admin.tableUrl'|trans }}</th>
                                <th style="width: 15%" class="text-center">{{ 'indexingDatabase.admin.tableStatus'|trans }}</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for proposal in rejectedProposals %}
                                {% include 'indexingDatabase/journal/_database_row.html.twig' with {
                                    database: proposal,
                                    lastColumn: 'status'
                                } %}
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        {% endif %}

    </div>
    {# Modal for proposing a new indexing database #}
    {% if canPropose %}
        <div class="modal fade" id="proposeModal" tabindex="-1"
             aria-labelledby="proposeModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="proposeModalLabel">
                            {{ 'indexingDatabase.journal.proposeTitle'|trans
                            }}
                        </h5>
                        <button type="button" class="btn-close"
                                data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-muted">{{
                            'indexingDatabase.journal.proposeInfo'|trans }}</p>
                        {% include 'indexingDatabase/_form.html.twig' with {
                            formAction: path('app_journal_indexing_propose',
                                {'code': code}),
                            csrfTokenId: 'indexing-propose',
                            cancelUrl: null,
                            submitLabel: 'indexingDatabase.journal.propose',
                            submitIcon: 'fa-paper-plane'
                        } %}
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}
